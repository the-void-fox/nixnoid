/* Тема rofi в цвет noctalia (desktop/components/noctalia/settings.nix):
 * схема Monochrome, непрозрачные панели, скругления 12, шрифт Arial.
 *
 * Шаблона для rofi у noctalia нет (есть fuzzel, walker, gtk, qt и другие),
 * поэтому сменишь схему там — цвета здесь правятся руками.
 */

* {
    bg:        #000000;
    fg:        #ffffff;
    accent:    #ffffff;
    on-accent: #000000;
    muted:     #9a9a9a;
    surface:   #141414;

    background-color: transparent;
    text-color:       @fg;
    font:             "Arial 12";
}

window {
    background-color: @bg;
    border:           2px;
    border-color:     @accent;
    border-radius:    12px;
    width:            36%;
    padding:          16px;
    children:         [ mainbox ];
}

mainbox {
    spacing:  12px;
    children: [ inputbar, listview ];
}

inputbar {
    background-color: @surface;
    border-radius:    12px;
    padding:          10px 14px;
    spacing:          10px;
    children:         [ prompt, entry ];
}

prompt {
    text-color: @accent;
    vertical-align: 0.5;
}

entry {
    placeholder:            "Поиск…";
    placeholder-color:      @muted;
    vertical-align:         0.5;
    cursor:                 text;
}

listview {
    lines:         10;
    scrollbar:     false;
    spacing:       4px;
    fixed-height:  false;
    dynamic:       true;
}

element {
    padding:       9px 14px;
    border-radius: 12px;
    cursor:        pointer;
}

element normal.normal {
    background-color: transparent;
    text-color:       @fg;
}

/* Выделение — инверсия, как у акцентных элементов noctalia:
   белая заливка, чёрный текст. */
element selected.normal {
    background-color: @accent;
    text-color:       @on-accent;
}

element alternate.normal {
    background-color: transparent;
    text-color:       @fg;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    vertical-align:   0.5;
}

element-icon {
    size:             1.1em;
    background-color: transparent;
    padding:          0 8px 0 0;
}

message {
    background-color: @surface;
    border-radius:    12px;
    padding:          10px 14px;
}

textbox {
    text-color: @fg;
}
